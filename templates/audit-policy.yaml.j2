---
apiVersion: audit.k8s.io/v1
kind: Policy
omitStages: ["RequestReceived"]
rules:
  - level: None  # Drop everything not explicitly allowed
    resources:
      - group: ""
        resources: ["pods", "events"]
  - level: Metadata
    resources:
      - group: ""
        resources: ["secrets", "configmaps"]     # never log secret payloads
  - level: RequestResponse
    resources:
      - group: "rbac.authorization.k8s.io"
      - group: "authentication.k8s.io"
      - group: "batch"
      - group: "extensions"
  - level: Request
    verbs: ["create", "update", "patch", "delete", "deletecollection"]
    resources:
      - group: ""
        resources: ["pods", "services", "ingresses"]
  - level: Metadata                           # catch-all
  - level: Metric
